{
  "name": "genshin-account-doctor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run",
    "test:app": "playwright test -c playwright.config.ts",
    "pages:verify": "node scripts/verify-pages.mjs",
    "knowledge:build": "node scripts/build-knowledge.mjs",
    "clears:refresh": "node scripts/refresh-clear-archive.mjs",
    "clears:verify": "node scripts/verify-clear-archive.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
